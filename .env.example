ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://kpi_helpdesk:kpi_helpdesk@localhost:5432/kpi_helpdesk
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]
SECURITY_HEADERS_ENABLED=true
AUDIO_STORAGE_DIR=backend/storage/audio
MAX_AUDIO_MB=30
ALLOWED_AUDIO_MIME_TYPES=["audio/webm","audio/wav","audio/x-wav","audio/mpeg","audio/mp4","audio/ogg"]
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
STT_WARMUP_ON_STARTUP=true
LLM_BASE_MODEL=Qwen/Qwen3-1.7B
LORA_ADAPTER_PATH=ml/models/qwen3-kpi-lora
LLM_DEVICE=auto
CLASSIFIER_MAX_NEW_TOKENS=128
CLASSIFIER_WARMUP_ON_STARTUP=true
VOICE_ASSISTANT_USE_LLM=true
VOICE_ASSISTANT_REUSE_CLASSIFIER_MODEL=true
VOICE_ASSISTANT_MAX_NEW_TOKENS=140
VOICE_ASSISTANT_MIN_CONFIDENCE=0.12
VOICE_ASSISTANT_MAX_CONTEXT_ITEMS=1
VOICE_ASSISTANT_TTS_ENABLED=true
VOICE_ASSISTANT_TTS_VOICE=uk-UA-PolinaNeural
VOICE_ASSISTANT_TTS_RATE=+0%
VOICE_ASSISTANT_TTS_MAX_CHARS=1800
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
