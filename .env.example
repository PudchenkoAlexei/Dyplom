ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://kpi_helpdesk:kpi_helpdesk@localhost:5432/kpi_helpdesk
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","host.docker.internal"]
SECURITY_HEADERS_ENABLED=true
AUDIO_STORAGE_DIR=backend/storage/audio
MAX_AUDIO_MB=30
ALLOWED_AUDIO_MIME_TYPES=["audio/webm","audio/wav","audio/x-wav","audio/mpeg","audio/mp4","audio/ogg"]
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
WHISPER_TEMPERATURE=0
WHISPER_DOMAIN_HINTS_ENABLED=true
WHISPER_DOMAIN_TERMS_MAX=160
WHISPER_TRANSCRIPTION_CORRECTIONS_ENABLED=true
STT_WARMUP_ON_STARTUP=true
LLM_BASE_MODEL=Qwen/Qwen3-4B-Instruct-2507
LORA_ADAPTER_PATH=ml/models/qwen3-kpi-lora-4b
LLM_DEVICE=auto
CLASSIFIER_QUANTIZATION=4bit
CLASSIFIER_MAX_NEW_TOKENS=128
CLASSIFIER_WARMUP_ON_STARTUP=true
VOICE_ASSISTANT_USE_LLM=true
VOICE_ASSISTANT_INFERENCE_ENGINE=transformers
VOICE_ASSISTANT_MODEL=Qwen/Qwen3-4B-Instruct-2507
VOICE_ASSISTANT_REUSE_CLASSIFIER_MODEL=false
VOICE_ASSISTANT_QUANTIZATION=none
VOICE_ASSISTANT_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
VOICE_ASSISTANT_OPENAI_API_KEY=local
VOICE_ASSISTANT_OPENAI_TIMEOUT_SECONDS=120
VOICE_ASSISTANT_OPENAI_TEMPERATURE=0
VOICE_ASSISTANT_AI_GUIDED_RETRIEVAL=true
VOICE_ASSISTANT_SEARCH_QUERY_COUNT=3
VOICE_ASSISTANT_SEARCH_CANDIDATES=8
VOICE_ASSISTANT_MAX_NEW_TOKENS=900
VOICE_ASSISTANT_PHONE_USE_LLM=true
VOICE_ASSISTANT_PHONE_INFERENCE_ENGINE=openai_compatible
VOICE_ASSISTANT_PHONE_MODEL=Qwen3-4B-KPI-Assistant-Q4_K_M
VOICE_ASSISTANT_PHONE_REUSE_CLASSIFIER_MODEL=false
VOICE_ASSISTANT_PHONE_QUANTIZATION=none
VOICE_ASSISTANT_PHONE_OPENAI_BASE_URL=http://127.0.0.1:8080/v1
VOICE_ASSISTANT_PHONE_OPENAI_API_KEY=local
VOICE_ASSISTANT_PHONE_OPENAI_TIMEOUT_SECONDS=120
VOICE_ASSISTANT_PHONE_OPENAI_TEMPERATURE=0
VOICE_ASSISTANT_PHONE_WARMUP_ON_STARTUP=false
VOICE_ASSISTANT_PHONE_MAX_NEW_TOKENS=0
VOICE_ASSISTANT_PHONE_AI_GUIDED_RETRIEVAL=false
VOICE_ASSISTANT_PHONE_MAX_CONTEXT_ITEMS=1
VOICE_ASSISTANT_MIN_CONFIDENCE=0.5
VOICE_ASSISTANT_SOFT_MIN_CONFIDENCE=0.32
VOICE_ASSISTANT_MAX_CONTEXT_ITEMS=5
VOICE_ASSISTANT_CONTEXT_SCORE_RATIO=0.65
VOICE_ASSISTANT_TTS_ENABLED=true
VOICE_ASSISTANT_TTS_VOICE=uk-UA-PolinaNeural
VOICE_ASSISTANT_TTS_RATE=+0%
VOICE_ASSISTANT_TTS_MAX_CHARS=0
PBX_INTERNAL_TOKEN=change-this-pbx-token-for-development
# LAN IP of the computer running Asterisk. Required for calling from Linphone on a phone.
KPI_PBX_PUBLIC_IP=192.168.0.141
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_PBX_WS_URL=ws://127.0.0.1:8088/ws
NEXT_PUBLIC_PBX_SIP_DOMAIN=127.0.0.1
NEXT_PUBLIC_PBX_WEBRTC_EXTENSION=7002
NEXT_PUBLIC_PBX_WEBRTC_PASSWORD=KpiWebPhone7002!
NEXT_PUBLIC_PBX_ASSISTANT_NUMBER=7000
